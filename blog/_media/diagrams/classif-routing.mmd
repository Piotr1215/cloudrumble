flowchart LR
    subgraph shell["Your shell or script"]
        direction TB
        Q[Question past the model window]
        O[Label, score, exit code, basis]
    end
    subgraph proc["classif process"]
        direction TB
        S[Search: index once, one judge call over the closest passages]
        C[Linked component, then full read]
        F[Full read: every passage, stop at a counterexample]
        W[Counted facts and an even sample, one judge call]
        G{Code decides whether the answer stands}
    end
    subgraph ollama["Ollama server on the GPU"]
        K[Root call: 12B reads the question alone, one token]
    end
    Q --> K
    K -- existence or state --> S
    K -- every case --> F
    K -- whole text --> W
    S -- yes, or a trusted no --> G
    S -- not settled --> C
    C --> G
    F --> G
    W --> G
    G --> O
    classDef semantic fill:#174a58,stroke:#69d7e3,color:#f3fafb,stroke-width:2px;
    classDef program fill:#1d2842,stroke:#9ab4ee,color:#f3f6fc,stroke-width:2px;
    classDef store fill:#2b2b3a,stroke:#c9b458,color:#f3f6fc,stroke-width:2px;
    class K semantic;
    class Q,O,S,C,F,W,G program;
