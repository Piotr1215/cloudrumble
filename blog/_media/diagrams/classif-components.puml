@startuml classif-components
skinparam dpi 150
skinparam shadowing true
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam ArrowColor #444444
skinparam componentStyle uml1
skinparam component {
  BackgroundColor<<CLI>> #5B8FD1
  BorderColor<<CLI>> #23466E
  FontColor<<CLI>> #FFFFFF
  StereotypeFontColor<<CLI>> #FFFFFF
  BackgroundColor<<CODE>> #B9D3EE
  BorderColor<<CODE>> #23466E
  BackgroundColor<<MODEL>> #E9B27E
  BorderColor<<MODEL>> #7A4A1E
}
skinparam database {
  BackgroundColor #D8D8D8
  BorderColor #555555
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam note {
  BackgroundColor #FFF2A8
  BorderColor #9C8500
}
skinparam legend {
  BackgroundColor #FAFAF5
}
skinparam cloud {
  BackgroundColor #FBF4EC
  BorderColor #7A4A1E
}
skinparam package {
  BackgroundColor #F4F8FC
  BorderColor #23466E
}

actor "Your script" as dev

component "classif" <<CLI>> as cli
component "Router" <<CODE>> as router

package "Long text plans" as plans {
  component "Search" <<CODE>> as search
  component "Linked lines" <<CODE>> as linked
  component "Full read" <<CODE>> as full
}

component "Gate" <<CODE>> as gate

cloud "Ollama on your machine" as ollama {
  component "Winnow-12B" <<MODEL>> as judge
  component "embeddinggemma" <<MODEL>> as embed
}

database "Cache" as cache

dev -right-> cli : pipes text\nand a question
cli -right-> ollama : short text:\none call
cli -down-> router : text is too long
router -down-> search : one passage\ncan settle it
router -down-> full : a claim about\nevery part
search -right-> linked : not settled
linked -right-> full : not settled
plans -down-> gate : answer and\nwhat was read
gate -left-> dev : label, probability, exit code
router ..> ollama : which kind\nof question?
plans ..> ollama : model calls
plans .left. cache : vectors and\nreadings

note right of gate
  Code checks that the reading
  covered the question before
  an answer may stand.
end note

legend bottom
  |= Type |= Description |
  | <color:#3A6DB0><b><<CLI>></b></color> | The command your script runs. |
  | <color:#5B8FD1><b><<CODE>></b></color> | Plain program steps. After an overflow, code keeps the long text and sends the model only selected parts. |
  | <color:#B06A28><b><<MODEL>></b></color> | Models served by Ollama on localhost. |
  | <b>Router</b> | One model call that reads only the question and picks a reading plan. |
  | <b>Search</b> | Ranks passages by words and by meaning. One call reads the closest 30,000 characters. |
  | <b>Linked lines</b> | Reads the lines connected to what the question names. |
  | <b>Full read</b> | Reads every passage, keeps the answers in a table and combines them in code. |
  | <b>Gate</b> | Returns the answer only when the reading covered the question. Otherwise "insufficient", exit 3. |
  | <b>Cache</b> | Optional (--cache). Keeps vectors and readings on disk so a repeat question is fast. |
endlegend
@enduml
