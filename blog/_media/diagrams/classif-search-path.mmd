flowchart LR
    subgraph shell["Your shell or script"]
        direction TB
        Q[Question]
        O[Answer, basis search]
        N[Next path: linked component, then full read]
    end
    subgraph proc["classif process, in memory"]
        direction TB
        S[Passages of about 1,200 chars]
        B[BM25 by stem, built each run]
        X[Vectors for this text]
        R[Order: 6 closest by words, 20 by vector, the rest by vector]
        C[Lines chained to the question's identifiers]
        F[Fill 30,000 chars, present in text order]
        G{Does the answer stand?}
    end
    subgraph disk["Disk, only with --cache"]
        DV[(Vectors, keyed by text digest and embedding model)]
    end
    subgraph ollama["Ollama server on the GPU"]
        direction TB
        E[Embedding model, 300M: passages once per text, then the question]
        J[Judge, 12B: one token]
    end
    Q --> E
    S --> B
    S --> E
    E --> X
    X <-- reuse or store --> DV
    B --> R
    X --> R
    R --> F
    C --> F
    F --> J
    J --> G
    G -- yes --> O
    G -- exists no, ranked by meaning --> O
    G -- state no --> O
    G -- anything else --> N
    classDef semantic fill:#174a58,stroke:#69d7e3,color:#f3fafb,stroke-width:2px;
    classDef program fill:#1d2842,stroke:#9ab4ee,color:#f3f6fc,stroke-width:2px;
    classDef store fill:#2b2b3a,stroke:#c9b458,color:#f3f6fc,stroke-width:2px;
    class E,J semantic;
    class Q,O,N,S,B,X,R,C,F,G program;
    class DV store;
